# Copy to .env and fill in. .env is gitignored and never leaves this machine.
#
#   cp .env.example .env
#
# Every value is optional. The dashboard degrades per-panel: anything without a
# token renders as "not configured" rather than breaking the page, so you can
# fill these in one at a time.

# --- Cloudflare -------------------------------------------------------------
# Used for cache purging. Create at:
#   Cloudflare dashboard > My Profile > API Tokens > Create Token
# Needs permission: Zone > Cache Purge > Purge
# Per-site zone IDs live in data/sites.json, not here.
CLOUDFLARE_API_TOKEN=

# --- Netlify ----------------------------------------------------------------
# Deploy history and build status. Create at:
#   Netlify > User settings > Applications > Personal access tokens
NETLIFY_AUTH_TOKEN=

# --- GitHub -----------------------------------------------------------------
# Pull requests and CI job status, via the bundled gh CLI.
# Create at: GitHub > Settings > Developer settings > Personal access tokens
# Needs scope: repo (read) — plus read:org if you query private org repos.
# Exported into the container as GH_TOKEN by docker-compose.
GITHUB_TOKEN=

# --- Plausible --------------------------------------------------------------
# Analytics. Stats API v2 key, created at:
#   Plausible > Site settings > API keys
PLAUSIBLE_API_KEY=
# Change if you self-host Plausible, e.g. https://analytics.example.org
PLAUSIBLE_BASE_URL=https://plausible.io

# --- Local port ---------------------------------------------------------------
# You should not need this. A source checkout serves on 4331 and a production
# install on 4332, so both run at once without configuration. Uncomment only if
# one of those is already taken on your machine.
#
# Careful: if you copy this file to a production install, an uncommented value
# here will override its 4332 default and collide with the dev server.
#CONTROL_ROOM_PORT=4333
