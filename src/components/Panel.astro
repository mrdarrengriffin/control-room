---
import type { PanelResult } from '../lib/types';

interface Props {
  /** Any provider result. Children render only when it succeeded. */
  result: PanelResult<unknown>;
}

const { result } = Astro.props;
---

{
  result.status === 'ok' ? (
    <slot />
  ) : (
    <p class={`panel-note${result.status === 'error' ? ' is-error' : ''}`}>
      <span aria-hidden="true">{result.status === 'error' ? '×' : '·'}</span>
      <span>
        <strong>{result.status === 'error' ? 'Error. ' : 'Not configured. '}</strong>
        {result.reason}
      </span>
    </p>
  )
}
