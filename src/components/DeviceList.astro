---
import BarList from './BarList.astro';
import { full } from '../lib/format';
import type { BreakdownRow } from '../lib/providers/plausible';

interface Props {
  rows: BreakdownRow[];
}

const { rows } = Astro.props;

/**
 * Material Symbols device glyphs, inlined. Plausible reports Desktop / Mobile /
 * Tablet, plus "(not set)" when it cannot tell.
 */
const ICONS: Record<string, string> = {
  desktop:
    'M21 2H3a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h7v2H8v2h8v-2h-2v-2h7a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm0 13H3V4h18v11Z',
  mobile:
    'M17 1H7a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm0 18H7V5h10v14Z',
  tablet:
    'M21 4H3a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-2 14H5V6h14v12Z',
  unknown:
    'M11 18h2v-2h-2v2Zm1-16A10 10 0 1 0 12 22 10 10 0 0 0 12 2Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16ZM12 6a4 4 0 0 0-4 4h2a2 2 0 1 1 3.4 1.4l-1.2 1.3A3 3 0 0 0 11 15h2c0-1 .3-1.4.9-2l.9-.9A4 4 0 0 0 12 6Z',
};

const iconFor = (label: string): string => {
  const key = label.toLowerCase();
  if (key.includes('desktop')) return ICONS.desktop;
  if (key.includes('mobile') || key.includes('phone')) return ICONS.mobile;
  if (key.includes('tablet')) return ICONS.tablet;
  return ICONS.unknown;
};

const entries = rows.map((row) => ({
  label: row.label === '(not set)' ? 'Unknown' : row.label,
  path: iconFor(row.label),
  visitors: row.visitors,
}));
---

{
  entries.length === 0 ? (
    <p class="empty">No device data in this range.</p>
  ) : (
    <>
      <ul class="inline-stats">
        {
          entries.map((entry) => (
            <li title={`${entry.label} — ${full(entry.visitors)} visitors`}>
              <svg
                class="inline-icon"
                viewBox="0 0 24 24"
                width="15"
                height="15"
                aria-hidden="true"
              >
                <path d={entry.path} />
              </svg>
              <span class="visually-hidden">{entry.label}</span>
              <span class="inline-value">{full(entry.visitors)}</span>
            </li>
          ))
        }
      </ul>

      {/* Same reasoning as countries: the icon row is the summary, this shows
          relative size. Values are already text above, so nothing is hidden. */}
      <details class="table-view">
        <summary>Compare</summary>
        <BarList
          rows={entries.map((entry) => ({
            label: entry.label,
            value: entry.visitors,
          }))}
          labelHeader="Device"
          valueHeader="Visitors"
          showTable={false}
        />
      </details>
    </>
  )
}
