---
import Shell from '../layouts/Shell.astro';
import StatusPill from '../components/StatusPill.astro';
import type { Tone } from '../components/StatusPill.astro';
import { verifyToken as verifyCloudflare } from '../lib/providers/cloudflare';
import { whoami as verifyGithub } from '../lib/providers/github';
import { verifyToken as verifyNetlify } from '../lib/providers/netlify';
import {
  findSiteId,
  summary as plausibleSummary,
} from '../lib/providers/plausible';
import { serviceStatuses } from '../lib/secrets';
import { loadRegistry } from '../lib/sites';
import {
  buildInfo,
  checkForUpdate,
  isPinnedTag,
  updaterConfigured,
} from '../lib/update';
import type { ConfigSource } from '../lib/env';
import type { PanelResult } from '../lib/types';

const params = Astro.url.searchParams;
const flash = params.get('flash');
const flashMessage = params.get('message');
const testing = params.get('test');
// Set by /api/update's redirect: the updater is pulling the new image and
// this container is about to be replaced under us.
const updating = params.get('updating') === '1';

const build = buildInfo();
const update = await checkForUpdate();
const canTrigger = updaterConfigured();
const shortSha = (sha: string | undefined) => (sha ?? '').slice(0, 7);

const services = await serviceStatuses();

/**
 * Run a live credential check for one service. Done during render off a query
 * param rather than via fetch, so it works with JavaScript disabled and the
 * result is a plain page you can link to.
 */
const runTest = async (id: string): Promise<PanelResult<string>> => {
  if (id === 'cloudflare') {
    const result = await verifyCloudflare();
    return result.status === 'ok'
      ? { status: 'ok', data: `Token active (${result.data.status})` }
      : result;
  }

  if (id === 'netlify') {
    const result = await verifyNetlify();
    return result.status === 'ok'
      ? { status: 'ok', data: `Authenticated as ${result.data.name}` }
      : result;
  }

  if (id === 'github') {
    const result = await verifyGithub();
    return result.status === 'ok'
      ? { status: 'ok', data: `Authenticated as ${result.data.login}` }
      : result;
  }

  if (id === 'plausible') {
    // Plausible has no "whoami", so the only real check is reading a site.
    const { sites } = await loadRegistry();
    // Any site will do: the provider resolves the site id from the URL when the
    // registry doesn't name one, so a site without a plausible block is testable.
    const candidate = sites[0];
    if (!candidate) {
      return {
        status: 'unconfigured',
        reason: 'Add a site first — the key can only be checked by reading one.',
      };
    }

    const resolved = await findSiteId(candidate);
    if (resolved.status !== 'ok') return resolved;

    const result = await plausibleSummary(candidate, '7d');
    if (result.status === 'ok') {
      return {
        status: 'ok',
        data: `Read ${resolved.data} — ${result.data.visitors} visitors in 7 days`,
      };
    }

    // Name the site id that was actually read. The www/bare spelling has already
    // been resolved by this point, so it is no longer a candidate explanation.
    return result.status === 'error'
      ? { status: 'error', reason: `Tested by reading ${resolved.data}. ${result.reason}` }
      : result;
  }

  return { status: 'error', reason: `Unknown service "${id}"` };
};

const testResult = testing ? await runTest(testing) : undefined;

const SOURCE_LABELS: Record<ConfigSource, string> = {
  settings: 'saved here',
  environment: 'environment',
  'env-file': '.env file',
  unset: 'not set',
};

const testHref = (id: string) => {
  const next = new URL(Astro.url);
  next.searchParams.set('test', id);
  next.searchParams.delete('flash');
  next.searchParams.delete('message');
  return `${next.pathname}${next.search}`;
};
---

<Shell title="Settings">
  <div class="page-head">
    <div>
      <h1>Settings</h1>
      <p>
        Connect the services this dashboard reads from. Everything stays on this
        machine.
      </p>
    </div>
  </div>

  {
    flash && flashMessage && (
      <p class={`flash ${flash === 'ok' ? 'is-ok' : 'is-error'}`}>{flashMessage}</p>
    )
  }

  <div class="card">
    <div class="card-head">
      <h2>Where values are stored</h2>
    </div>
    <p class="finding-description">
      Anything saved here is written to <code>data/secrets.json</code>, which is
      gitignored and never leaves this machine. It is written there rather
      than{' '}<code>.env</code>{' '}so that hand-written comments in your{' '}
      <code>.env</code>{' '}survive.
    </p>
    <p class="finding-description">
      Three sources are consulted, highest priority first: <strong>saved
      here</strong>, then <strong>environment</strong> variables from Docker, then
      the <strong>.env file</strong>. Each field below says which one is actually
      in effect, so nothing is ambiguous. Saved values take effect immediately —
      no restart.
    </p>
  </div>

  {
    services.map((service) => (
      <div class="card">
        <div class="card-head">
          <h2>{service.name}</h2>
          {
            /* Only credential groups have a connection state to report. */
            service.fields.some((field) => field.secret) && (
              <StatusPill
                tone={(service.configured ? 'good' : 'neutral') as Tone}
                label={service.configured ? 'connected' : 'not connected'}
              />
            )
          }
        </div>

        <p class="finding-description">{service.what}</p>
        <p class="finding-description" style="color:var(--ink-muted)">
          {service.where}
        </p>

        {
          service.fields.map((field) => (
            <div class="setting-field">
              <div class="setting-head">
                <strong>{field.label}</strong>
                <code class="setting-key">{field.key}</code>
                <span class="tag">
                  {SOURCE_LABELS[field.source]}
                  {
                    field.secret && field.source !== 'unset'
                      ? ` · ${field.length} chars`
                      : ''
                  }
                </span>
              </div>

              <p class="setting-hint">{field.hint}</p>

              <form method="POST" action="/api/settings" class="setting-form">
                <input type="hidden" name="key" value={field.key} />
                <input type="hidden" name="action" value="save" />
                {
                  field.choices ? (
                    <select name="value">
                      {
                        field.choices.map((choice) => (
                          <option
                            value={choice.value}
                            selected={choice.value === field.value}
                          >
                            {choice.label}
                          </option>
                        ))
                      }
                    </select>
                  ) : field.secret ? (
                    <input
                      type="password"
                      name="value"
                      autocomplete="off"
                      spellcheck="false"
                      placeholder={
                        field.source === 'unset'
                          ? 'Paste token'
                          : 'Paste a new token to replace it'
                      }
                    />
                  ) : (
                    <input
                      type="text"
                      name="value"
                      autocomplete="off"
                      spellcheck="false"
                      value={field.value ?? ''}
                      placeholder={field.placeholder}
                    />
                  )
                }
                <button class="button is-primary" type="submit">Save</button>
              </form>

              {
                field.source === 'settings' && (
                  <form method="POST" action="/api/settings" class="setting-form">
                    <input type="hidden" name="key" value={field.key} />
                    <input type="hidden" name="action" value="clear" />
                    <button class="button" type="submit">
                      Clear saved value
                    </button>
                  </form>
                )
              }
            </div>
          ))
        }

        <div class="button-row" style="margin-top:12px">
          {
            service.fields.some((field) => field.secret) && (
              <a class="button" href={testHref(service.id)}>Test connection</a>
            )
          }
          {
            testing === service.id && testResult && (
              <span
                class={`flash ${testResult.status === 'ok' ? 'is-ok' : 'is-error'}`}
                style="padding:6px 10px"
              >
                {
                  testResult.status === 'ok'
                    ? testResult.data
                    : testResult.reason
                }
              </span>
            )
          }
        </div>
      </div>
    ))
  }

  <div class="card" id="updates">
    <div class="card-head">
      <h2>Software update</h2>
      {
        update.status === 'ok' && (
          <StatusPill
            tone={(update.data.updateAvailable ? 'warning' : 'good') as Tone}
            label={update.data.updateAvailable ? 'update available' : 'up to date'}
          />
        )
      }
      {
        update.status === 'error' && (
          <StatusPill tone={'neutral' as Tone} label="check failed" />
        )
      }
    </div>

    {
      update.status === 'unconfigured' ? (
        <p class="finding-description">{update.reason}</p>
      ) : (
        <p class="finding-description">
          Running <strong>{build.version || 'an unlabelled build'}</strong>
          {build.sha ? <> (<code>{shortSha(build.sha)}</code>)</> : null}, following
          the <code>{build.tag}</code> tag.
          {
            isPinnedTag(build.tag) && (
              <>
                {' '}That is an exact version pin, so this install only changes
                when you edit <code>CONTROL_ROOM_TAG</code> — the tag itself
                never moves.
              </>
            )
          }
        </p>
      )
    }

    {
      update.status === 'error' && (
        <p class="finding-description" style="color:var(--ink-muted)">
          Could not compare against the registry: {update.reason}
        </p>
      )
    }

    {
      update.status === 'ok' && update.data.updateAvailable && (
        <p class="finding-description">
          The registry now serves{' '}
          <strong>{update.data.remoteVersion || 'a newer build'}</strong>{' '}
          (<code>{shortSha(update.data.remoteSha)}</code>) for{' '}
          <code>{update.data.tag}</code>.
        </p>
      )
    }

    {
      updating ? (
        <p class="flash is-ok" id="update-restart-watch">
          Pulling the new image and restarting… this page will reconnect by
          itself.
        </p>
      ) : update.status === 'ok' && update.data.updateAvailable ? (
        canTrigger ? (
          <form method="POST" action="/api/update" class="button-row">
            <button class="button is-primary" type="submit">Update now</button>
          </form>
        ) : (
          <p class="finding-description">
            No updater is running beside this container, so update from the
            machine itself:{' '}
            <code>{'docker compose pull && docker compose up -d'}</code>. The
            compose file in <code>deploy/</code> includes an updater service
            that makes this a one-click button.
          </p>
        )
      ) : null
    }
  </div>
</Shell>

<script>
  /*
   * Only present mid-update. The container is being replaced, so watch the open
   * health endpoint: it keeps answering until the swap, goes unreachable for a
   * few seconds, then answers again from the new image — and only that
   * down-then-up transition means the restart happened. Reloading on the first
   * OK would declare victory while the old container was still serving.
   */
  const watch = document.getElementById('update-restart-watch');
  if (watch) {
    const started = Date.now();
    let sawDown = false;

    const tick = async () => {
      if (Date.now() - started > 10 * 60_000) {
        watch.textContent =
          'Still not back after 10 minutes — check `docker compose logs updater` on the machine.';
        watch.classList.remove('is-ok');
        watch.classList.add('is-error');
        return;
      }

      try {
        const response = await fetch('/api/health', { cache: 'no-store' });
        if (response.ok && sawDown) {
          location.href = '/settings#updates';
          return;
        }
        if (!response.ok) sawDown = true;
      } catch {
        sawDown = true;
      }

      setTimeout(tick, 3_000);
    };

    setTimeout(tick, 3_000);
  }
</script>
