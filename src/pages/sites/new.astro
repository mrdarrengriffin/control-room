---
import Shell from '../../layouts/Shell.astro';
import { forgetScan, scanCloudflare } from '../../lib/scan';
import type { ScanResult } from '../../lib/scan';
import { messageOf } from '../../lib/types';

/**
 * Adding sites: one at a time by URL, or in bulk from Cloudflare.
 *
 * There used to be a confirmation step — look the URL up, review four findings,
 * then save. It has gone. Everything it showed can be changed afterwards on the
 * site's own edit page, so the review screen only ever stood between you and
 * the thing you had already decided to do. Discovery still runs; it just runs
 * on the way in rather than in front of you.
 */

const params = Astro.url.searchParams;
const flash = params.get('flash');
const flashMessage = params.get('message');

/*
 * The zone list is cached for an hour with stale-while-revalidate and this page
 * re-renders on its own timer, so the scan stays current without a scheduler.
 * ?rescan=1 drops just that cache entry for when you have only now added a zone.
 */
if (params.has('rescan')) forgetScan();

let scan: ScanResult | undefined;
let scanError: string | undefined;

try {
  scan = await scanCloudflare();
} catch (error) {
  scanError = messageOf(error);
}
---

<Shell title="Add a site">
  <div class="page-head">
    <div>
      <h1>Add a site</h1>
      <p>
        Give a URL, or pick from the Cloudflare zones below. Connected services
        are searched as it saves, and anything they miss can be filled in by
        editing the site.
      </p>
    </div>
  </div>

  {
    flash && flashMessage && (
      <p class={`flash ${flash === 'ok' ? 'is-ok' : 'is-error'}`}>{flashMessage}</p>
    )
  }

  <div class="card">
    <form method="POST" action="/api/sites/add" class="url-form">
      <div class="field" style="flex:1 1 320px; margin:0">
        <label for="url">Site URL</label>
        <input
          type="text"
          id="url"
          name="url"
          placeholder="https://example.org"
          autocomplete="off"
          spellcheck="false"
          required
        />
      </div>
      <button class="button is-primary" type="submit">Add site</button>
    </form>

    <p class="setting-hint">
      A path is kept as a test page, not a separate site — adding
      <code>example.org/docs</code> gives you the site with <code>/docs</code>
      ready to audit.
    </p>
  </div>

  {scanError && <p class="flash is-error">{scanError}</p>}

  {
    scan && (
      <section class="card">
        <div class="card-head">
          <h2>From Cloudflare</h2>
          <span class="hint">
            {scan.status !== 'ok'
              ? 'Not available'
              : scan.candidates.length === 0
                ? `All ${scan.total} zones already added`
                : `${scan.candidates.length} of ${scan.total} zones not added yet`}
          </span>
        </div>

        {scan.status === 'unconfigured' ? (
          <p class="empty">
            Connect Cloudflare in <a href="/settings">Settings</a> and your zones
            will be listed here, ready to add.
          </p>
        ) : scan.status === 'error' ? (
          <p class="panel-note is-error">
            <span aria-hidden="true">×</span>
            <span>{scan.detail}</span>
          </p>
        ) : (
          <form method="POST" action="/api/sites/import">
            <input type="hidden" name="from" value="new" />

            {/* Two dozen zones is normal, so ticking one at a time is not a
                reasonable ask. Inert without JavaScript; the checkboxes still
                work. */}
            {scan.candidates.length > 0 && (
              <div class="button-row" style="margin-bottom:8px">
                <button class="button" type="button" data-scan-all>Select all</button>
                <button class="button" type="button" data-scan-none>Select none</button>
              </div>
            )}

            {/* Every zone, not just the new ones. Seeing what is already here
                is how you tell "nothing to add" apart from "Cloudflare returned
                nothing", and it makes the list a readable inventory. */}
            <ul class="scan-list">
              {scan.candidates.map((domain) => (
                <li>
                  <label class="scan-item">
                    <input type="checkbox" name="domains" value={domain} />
                    <span class="scan-domain">{domain}</span>
                  </label>
                </li>
              ))}
              {scan.alreadyAdded.map((domain) => (
                <li class="is-added">
                  <span class="scan-item">
                    <input type="checkbox" checked disabled />
                    <span class="scan-domain">{domain}</span>
                    <span class="scan-note">added</span>
                  </span>
                </li>
              ))}
            </ul>

            <div class="button-row">
              {scan.candidates.length > 0 && (
                <button class="button is-primary" type="submit">Add selected</button>
              )}
              <a class="button" href="/sites/new?rescan=1">Refresh from Cloudflare</a>
              <span class="hint">
                {scan.candidates.length === 0
                  ? 'Every Cloudflare zone is already a site here. '
                  : 'These are added by domain — open a site afterwards to fill in its deploy and repository. '}
                The zone list is re-read hourly.
              </span>
            </div>
          </form>
        )}
      </section>
    )
  }

  <script>
    // Bulk tick for the zone list. Only the addable ones: the already-added rows
    // carry a ticked, disabled box to show they are here already, and unticking
    // those made them read as not added.
    const boxes = () =>
      document.querySelectorAll<HTMLInputElement>('.scan-list input[name="domains"]');
    const setAll = (checked: boolean) => {
      for (const box of boxes()) box.checked = checked;
    };
    document
      .querySelector('[data-scan-all]')
      ?.addEventListener('click', () => setAll(true));
    document
      .querySelector('[data-scan-none]')
      ?.addEventListener('click', () => setAll(false));
  </script>
</Shell>
