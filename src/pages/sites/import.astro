---
import Shell from '../../layouts/Shell.astro';
import { loadRegistry } from '../../lib/sites';
import { exportDomains, exportJson } from '../../lib/transfer';

/**
 * Move a site list between installs.
 *
 * Both directions on one page on purpose: the person exporting and the person
 * importing are usually the same two people in the same conversation, and
 * splitting it across two screens would only mean explaining where the other
 * one is.
 */

const params = Astro.url.searchParams;
const flash = params.get('flash');
const flashMessage = params.get('message');

const { sites } = await loadRegistry();
const json = exportJson(sites);
const domains = exportDomains(sites);
---

<Shell title="Import & export">
  <header class="page-head">
    <div>
      <h1>Import &amp; export</h1>
      <p class="hint">
        Add several sites at once, or hand your list to someone else.
      </p>
    </div>
  </header>

  {
    flash && flashMessage && (
      <p class={`flash ${flash === 'ok' ? 'is-ok' : 'is-error'}`}>
        {flashMessage}
      </p>
    )
  }

  <section class="card">
    <div class="card-head">
      <h2>Bulk add</h2>
      <span class="hint">Paste a list of domains, or exported JSON.</span>
    </div>

    <form method="POST" action="/api/sites/import" class="stack">
      <div class="field">
        <label for="payload">Sites to add</label>
        <textarea
          id="payload"
          name="payload"
          rows="10"
          spellcheck="false"
          placeholder={'example.org\ndocs.example.org\nblog.example.org\n\n…or paste the JSON from an export.'}
          required></textarea>
      </div>

      <p class="setting-hint">
        One domain per line, or comma separated — full URLs are fine and get
        reduced to the domain. Lines starting with <code>#</code> are ignored.
        Anything beginning with <code>&#123;</code> or <code>[</code> is read as
        JSON instead, so an export pastes in directly.
      </p>

      <div class="button-row">
        <button class="button is-primary" type="submit">Add sites</button>
        <span class="hint">
          Sites you already have are skipped, so re-pasting a list is safe.
        </span>
      </div>
    </form>

    <p class="panel-note">
      <span aria-hidden="true">i</span>
      <span>
        A bulk add stores exactly what you paste — it does not search your
        connected services. For a domain list that means Plausible works
        immediately and the rest fill in when you use
        <strong>Look up missing details</strong> on a site, or
        <a href="/sites/new">add a site by URL</a> instead, which discovers
        everything up front.
      </span>
    </p>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>Export</h2>
      <span class="hint">
        {sites.length === 0
          ? 'Nothing to export yet'
          : `${sites.length} site${sites.length === 1 ? '' : 's'}`}
      </span>
    </div>

    {
      sites.length === 0 ? (
        <p class="empty">
          Add a site first and it will show up here, ready to hand to someone
          else.
        </p>
      ) : (
        <>
          <div class="button-row">
            <a class="button" href="/api/sites/export" download>
              Download sites.json
            </a>
            <a class="button" href="/api/sites/export?format=domains" download>
              Download domain list
            </a>
          </div>

          <details class="table-view">
            <summary>Full export — domains, ids, repos and test pages</summary>
            <textarea class="export-box" rows="14" readonly spellcheck="false">{json}</textarea>
            <p class="setting-hint">
              This is valid <code>data/sites.json</code>, so it can be pasted
              into the box above on another install or dropped straight into its
              data directory.
            </p>
          </details>

          <details class="table-view">
            <summary>Domains only — the other install discovers its own ids</summary>
            <textarea class="export-box" rows="8" readonly spellcheck="false">{domains}</textarea>
          </details>

          <p class="panel-note">
            <span aria-hidden="true">i</span>
            <span>
              <strong>No credentials are included.</strong> An export lists
              domains and the identifiers of the resources behind them —
              Cloudflare zone ids, Netlify site ids, repository names. Tokens
              live in <code>data/secrets.json</code> and never leave this
              machine, so whoever you send this to needs their own.
            </span>
          </p>
        </>
      )
    }
  </section>
</Shell>
