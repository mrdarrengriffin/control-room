---
import Shell from '../../layouts/Shell.astro';
import { loadRegistry } from '../../lib/sites';
import { exportDomains } from '../../lib/transfer';

/**
 * Move a site list between installs, as a plain list of domains.
 *
 * Nothing but domains, on purpose. Identifiers — zone ids, Netlify site ids,
 * repositories — are specific to whoever's accounts they came from and are of
 * no use to anyone else's, so the receiving install rediscovers its own.
 */

const params = Astro.url.searchParams;
const flash = params.get('flash');
const flashMessage = params.get('message');

const { sites } = await loadRegistry();
const domains = exportDomains(sites);
---

<Shell title="Import & export">
  <header class="page-head">
    <div>
      <h1>Import &amp; export</h1>
      <p class="hint">
        Add several sites at once, or hand your list to someone else.
      </p>
    </div>
  </header>

  {
    flash && flashMessage && (
      <p class={`flash ${flash === 'ok' ? 'is-ok' : 'is-error'}`}>
        {flashMessage}
      </p>
    )
  }

  <section class="card">
    <div class="card-head">
      <h2>Bulk add</h2>
      <span class="hint">One domain per line.</span>
    </div>

    <form method="POST" action="/api/sites/import">
      <div class="field">
        <label for="payload">Domains to add</label>
        <textarea
          id="payload"
          name="payload"
          rows="10"
          spellcheck="false"
          placeholder={'example.org\ndocs.example.org\nblog.example.org'}
          required></textarea>
      </div>

      <p class="setting-hint">
        Newlines or commas. Full URLs are fine and get reduced to the domain,
        and lines starting with <code>#</code> are ignored.
      </p>

      <div class="button-row">
        <button class="button is-primary" type="submit">Add sites</button>
        <span class="hint">
          Sites you already have are skipped, so re-pasting a list is safe.
        </span>
      </div>
    </form>

    <p class="panel-note">
      <span aria-hidden="true">i</span>
      <span>
        A bulk add stores just the domain. Analytics work immediately; zones,
        deploys and repositories fill in when you use
        <strong>Look up missing details</strong> on a site. To find everything
        up front, <a href="/sites/new">add a site by URL</a> — or use
        <strong>Discover</strong> there to sweep your connected services.
      </span>
    </p>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>Export</h2>
      <span class="hint">
        {sites.length === 0
          ? 'Nothing to export yet'
          : `${sites.length} site${sites.length === 1 ? '' : 's'}`}
      </span>
    </div>

    {
      sites.length === 0 ? (
        <p class="empty">
          Add a site first and it will show up here, ready to hand to someone
          else.
        </p>
      ) : (
        <>
          <textarea class="export-box" rows="10" readonly spellcheck="false">{domains}</textarea>

          <div class="button-row">
            <a class="button" href="/api/sites/export" download>
              Download list
            </a>
          </div>

          <p class="panel-note">
            <span aria-hidden="true">i</span>
            <span>
              Domains only — no tokens, and no identifiers from your accounts.
              Whoever you send this to pastes it into their own Bulk add, and
              their install discovers its own zones, deploys and repositories.
            </span>
          </p>
        </>
      )
    }
  </section>
</Shell>
